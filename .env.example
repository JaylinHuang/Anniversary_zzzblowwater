# 整站群口令（初始可用；管理员也可在后台改口令，改后以数据库为准）
SITE_PASSPHRASE=zzzblowwater

# —— 建档：QQ 邮箱验证码（管理员 QQ 邮箱 SMTP）——
# 在 QQ 邮箱网页版开启 SMTP，并生成「授权码」（不是登录密码）
# QQ_SMTP_USER=你的QQ号@qq.com
# QQ_SMTP_PASS=授权码
# QQ_SMTP_HOST=smtp.qq.com
# QQ_SMTP_PORT=465
# QQ_SMTP_FROM=你的QQ号@qq.com

# —— 方案 B：OneBot / NapCat 实时同步（可选）——
# 机器人 HTTP 上报鉴权令牌（必填才会启用 webhook）
ONEBOT_ACCESS_TOKEN=change-me-to-a-long-random-string
# 仅同步该群号；不填则接收所有群消息（不推荐）
# ONEBOT_GROUP_ID=123456789

# —— 群友 Agent 单聊（OpenAI 兼容；群名：zzz吹水群）——
# Agent 由管理员在网页手动建档（姓名/插画/绑 QQ），不再自动水位线准入
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat
# AGENT_PERSONA_SAMPLE_SIZE=120
# AGENT_DRIFT_EVERY_N_TURNS=8
# 每用户每日单聊轮次上限
# AGENT_DM_DAILY_LIMIT=40
#
# —— Agent 向量检索 RAG（可选；按人索引近期发言，对话时语义召回）——
# DeepSeek 等纯聊天接口通常没有 /embeddings，需单独配置支持向量的端点，例如 OpenAI：
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_ENABLED=1
# RAG_TOP_K=6
# RAG_INDEX_PER_QQ=500
# 每用户每日祝福条数上限
# WISH_DAILY_LIMIT=5
# 每用户每日「猜说话人」出题上限
# GUESS_DAILY_LIMIT=30

# 生产环境建议设置
# NODE_ENV=production
# PORT=3000

# 冒烟测试（可选）
# SMOKE_BASE=http://localhost:3000
